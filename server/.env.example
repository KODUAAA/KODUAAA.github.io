# Copy this file to .env for local development. Never commit .env.
# On Render, set these under the service's "Environment" tab instead.

PORT=3000

# Comma-separated list of sites allowed to call the API (your portfolio's URL, no trailing slash).
ALLOWED_ORIGINS=https://koduaaa.github.io,http://localhost:5500,http://127.0.0.1:5500

# PostgreSQL connection string, e.g. from Neon (https://neon.tech, free tier).
# Leave empty locally to save messages to data/messages.jsonl instead.
DATABASE_URL=

# Email notifications via Resend (https://resend.com, free tier).
# Without your own domain, Resend can only send to the email address you signed up with, which is all we need.
RESEND_API_KEY=
NOTIFY_TO=brightkoduaakwasi@gmail.com
NOTIFY_FROM=Portfolio <onboarding@resend.dev>

# Max messages per IP per window (default 5 per 15 minutes).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000
